rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@dakshyam.com'
      );
    }

    function isTrainer() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'trainer'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDataSizeOk(data) {
      return data.size() < 100;
    }

    // Verifications (OTP Codes) - Protected, never public
    match /verifications/{email} {
      allow read, write: if isAdmin();
    }

    // Students Collection: Students can only read/update their own record. Admins/Trainers can read/manage.
    match /students/{studentId} {
      allow read: if isOwner(studentId) || isTrainer();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(studentId) || isAdmin();
    }

    // Trainers Collection: Faculty profiles
    match /trainers/{trainerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(trainerId) || isAdmin();
    }

    // Project Groups Collection: Team performance matrix
    match /groups/{groupId} {
      allow read: if true; // Public leaderboard visibility
      allow write: if isTrainer();
    }

    // Videos Collection: Project video telemetry feed
    match /videos/{videoId} {
      allow read: if true; // Public video wall
      allow write: if isTrainer();
    }

    // Certificates Collection: Public credential verification
    match /certificates/{certificateId} {
      allow read: if true; // Verification engine is public
      allow write: if isTrainer();
    }

    // Applications Collection: Course registration applications
    match /applications/{applicationId} {
      allow create: if isAuthenticated() && isDataSizeOk(request.resource.data);
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isTrainer());
      allow update, delete: if isTrainer();
    }

    // Special Programs & Bootcamps
    match /special_programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /special_enrollments/{enrollmentId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isTrainer();
    }

    // Settings Collection: Strictly protected. Supervisor PIN restricted to Admin!
    match /settings/{settingId} {
      allow read: if (settingId in ['company_about', 'page_loader_config', 'workshop_feedback_config', 'home_3d_model']) || isAdmin();
      allow write: if isAdmin();
    }

    // Workshop Feedbacks: Public participants can create feedback; only Admins can read or delete
    match /workshop_feedbacks/{feedbackId} {
      allow create: if request.resource.data.fullName is string 
                    && request.resource.data.email is string
                    && request.resource.data.workshopId is string
                    && isDataSizeOk(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Workshop Feedback Configurations
    match /workshop_feedback_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Role-based In-App Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
